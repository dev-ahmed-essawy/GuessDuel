<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117">

    <!-- ✅ TOP CONTENT (ALWAYS VISIBLE) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/turnText"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    
        <TextView
            android:id="@+id/scoreText"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    
        <TextView
            android:id="@+id/livesText"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    
        <TextView
            android:id="@+id/timerText"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    
        <TextView
            android:id="@+id/resultText"
            android:textColor="#00E676"
            android:layout_marginBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    
        <!-- DISPLAY -->
        <TextView
            android:id="@+id/inputDisplay"
            android:text="0"
            android:textSize="40sp"
            android:textColor="#00E676"
            android:background="#161B22"
            android:padding="12dp"
            android:gravity="center"
            android:layout_marginBottom="20dp"
            android:layout_width="200dp"
            android:layout_height="wrap_content"/>
    
    
    </LinearLayout>

    <!-- ✅ KEYPAD ONLY (THIS WILL BE HIDDEN) -->
    <LinearLayout
        android:id="@+id/keypadContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="20dp">

        <!-- KEYPAD -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:columnCount="3">
    
            <Button
                android:id="@+id/btn1"
                android:text="1"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="8dp"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/keypad_btn"/>
                
            <Button 
                android:id="@+id/btn2" 
                android:text="2"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="8dp"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/keypad_btn"/>
                
            <Button android:id="@+id/btn3" android:text="3"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="8dp"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/keypad_btn"/>
    
            <Button android:id="@+id/btn4" android:text="4"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="8dp"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/keypad_btn"/>
            <Button android:id="@+id/btn5" android:text="5"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="8dp"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/keypad_btn"/>
            <Button android:id="@+id/btn6" android:text="6"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="8dp"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/keypad_btn"/>
    
            <Button android:id="@+id/btn7" android:text="7"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="8dp"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/keypad_btn"/>
            <Button android:id="@+id/btn8" android:text="8"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="8dp"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/keypad_btn"/>
            <Button android:id="@+id/btn9" android:text="9"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="8dp"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/keypad_btn"/>
    
            <Button android:id="@+id/btnDel" android:text="DEL"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="8dp"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D32F2F"/>
            <Button android:id="@+id/btn0" android:text="0"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="8dp"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/keypad_btn"/>
            <Button android:id="@+id/btnOk" android:text="OK"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="8dp"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#00C853"/>
    
        </GridLayout>

    </LinearLayout>
</LinearLayout>
